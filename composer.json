{
    "name": "thepublicgood/analytics",
    "description": "Send page views, requests and custom events to thepublicgood.analytics from PHP and Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["analytics", "laravel", "privacy"],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-zlib": "Compresses event batches before they are sent.",
        "illuminate/support": "Adds the Laravel service provider, facade and request tracking middleware."
    },
    "autoload": {
        "psr-4": {
            "TPG\\Analytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thepublicgood\\Analytics\\Laravel\\AnalyticsServiceProvider"
            ],
            "aliases": {
                "Analytics": "TPG\\Analytics\\Laravel\\Analytics"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
